# ============================================================
# Hostinger VPS - Docker Compose variable substitution file
# ============================================================
# Copy this file to deploy/hostinger/.env and fill in values.
# This file is read by docker-compose for ${VAR} substitution.
# DO NOT commit the real .env file — it is gitignored.
# ============================================================

# Public API URL and client identity are baked into admin + storefront builds.
# Replace every example value before using this compose file in production.
COMPOSE_PROJECT_NAME=kvastram_store
NEXT_PUBLIC_API_URL=https://api.store.example.com
STORE_NAME=Kvastram Store
BACKEND_HOST_PORT=4100
STOREFRONT_HOST_PORT=3100
ADMIN_HOST_PORT=3101
