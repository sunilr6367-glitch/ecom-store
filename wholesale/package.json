{
  "name": "wholesale",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build",
    "start": "next start -p 3001 -H 0.0.0.0",
    "lint": "eslint",
    "audit:design-system": "node scripts/design-system-audit.mjs",
    "audit:css-ownership": "node scripts/css-ownership-audit.mjs",
    "audit:design-system:metrics": "node scripts/design-system-metrics.mjs",
    "verify:design-system": "npm run audit:design-system && npm run audit:css-ownership && npm run lint && npm run test:unit -- --run",
    "test:e2e": "playwright test",
    "test:unit": "vitest",
    "test:unit:coverage": "vitest --coverage",
    "live-audit": "node scripts/live-design-audit.mjs"
  },
  "dependencies": {
    "@opentelemetry/instrumentation-http": "^0.219.0",
    "@paypal/react-paypal-js": "^9.1.1",
    "@react-oauth/google": "^0.12.1",
    "@sentry/nextjs": "^10.59.0",
    "@stripe/react-stripe-js": "^5.6.0",
    "@stripe/stripe-js": "^8.7.0",
    "clsx": "^2.1.1",
    "embla-carousel-autoplay": "^8.6.0",
    "embla-carousel-react": "^8.6.0",
    "framer-motion": "^12.33.0",
    "logrocket": "^12.0.0",
    "lucide-react": "^0.563.0",
    "next": "^16.2.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
