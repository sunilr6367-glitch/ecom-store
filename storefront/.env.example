# ============================================
# KVASTRAM COMMERCE STOREFRONT - ENVIRONMENT VARIABLES
# ============================================

# API Configuration (Required)
NEXT_PUBLIC_API_URL=http://localhost:4100
NEXT_PUBLIC_SITE_URL=http://localhost:3100
REVALIDATE_SECRET=choose-a-shared-secret

# Client brand configuration
NEXT_PUBLIC_STORE_NAME=Kvastram Store
NEXT_PUBLIC_STORE_LEGAL_NAME=Kvastram Store
NEXT_PUBLIC_SUPPORT_EMAIL=support@example.com
NEXT_PUBLIC_WHOLESALE_EMAIL=wholesale@example.com
NEXT_PUBLIC_SUPPORT_PHONE=+00 00000 00000
NEXT_PUBLIC_SUPPORT_HOURS=Monday-Friday, 9 AM - 6 PM
NEXT_PUBLIC_STORE_LOCATION=Online store
NEXT_PUBLIC_STORE_ADDRESS=Address line 1|City, State, Postal code|Country
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/
NEXT_PUBLIC_WHATSAPP_URL=https://wa.me/000000000000
NEXT_PUBLIC_DEFAULT_CURRENCY=USD
NEXT_PUBLIC_PAYMENT_LOGO_PATH=/logo.png

# ============================================
# PAYMENT CONFIGURATION
# ============================================
# Stripe (international fallback)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here

# Razorpay (India / INR payments) — key_id is public, safe to expose
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_your_key_id

# PayPal (international payments) — client_id is public, safe to expose
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id

# ============================================
# SOCIAL AUTHENTICATION (Optional)
# ============================================
# Google OAuth: https://console.cloud.google.com
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id_here

# Facebook Login: https://developers.facebook.com
NEXT_PUBLIC_FACEBOOK_APP_ID=your_facebook_app_id_here

# ============================================
# ERROR TRACKING & MONITORING (Optional)
# ============================================
# Sentry: https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn_here

# LogRocket: https://logrocket.com
NEXT_PUBLIC_LOGROCKET_APP_ID=your_app_id/your_org

# ============================================
# REAL-TIME FEATURES (Optional)
# ============================================
# WebSocket URL (defaults to API_URL if not set)
NEXT_PUBLIC_WS_URL=http://localhost:4100

# Enable WebSocket in development (set to 'true' to enable)
NEXT_PUBLIC_ENABLE_WS_DEV=true

# ============================================
# CHAT WIDGET (Optional)
# ============================================
# Tawk.to: Get your property ID from tawk.to dashboard
NEXT_PUBLIC_TAWK_PROPERTY_ID=your_property_id/your_widget_id

# ============================================
# APP VERSION (Optional)
# ============================================
NEXT_PUBLIC_APP_VERSION=1.0.0

# ============================================
# SENTRY BUILD CONFIG (Optional - for CI/CD)
# ============================================
SENTRY_ORG=your-organization
SENTRY_PROJECT=storefront
