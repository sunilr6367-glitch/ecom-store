# ============================================================
# Admin Panel - Production Environment Variables
# ============================================================
# Copy to admin/.env.production on the VPS and fill values.
# DO NOT commit this file with real secrets.
# ============================================================

# Public API URL — browser-accessible backend endpoint.
# Used as a build-time arg in Docker (NEXT_PUBLIC_API_URL).
# Set in deploy/hostinger/.env instead (docker-compose reads it as build arg).
# NEXT_PUBLIC_API_URL=https://api.odhvica.com

# Node environment (set automatically by docker-compose)
NODE_ENV=production
