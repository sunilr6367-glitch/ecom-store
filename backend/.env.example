# Database Configuration
DATABASE_URL=postgresql://user:password@host:port/database

# Server Configuration
PORT=3000
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

# API Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Stripe Payment Integration (Optional)
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Razorpay Payment Integration (India / INR — Optional)
# Get keys: razorpay.com → Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# PayPal Payment Integration (International — Optional)
# Get keys: developer.paypal.com → My Apps → Create App
PAYPAL_SANDBOX=true
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_webhook_id

# Social Login
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Frontend URLs
STOREFRONT_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001
STOREFRONT_REVALIDATE_SECRET=choose-a-shared-secret

# Tax Configuration (GST)
DEFAULT_TAX_RATE=18

# Brevo Configuration
BREVO_API_KEY=your_brevo_api_key

# Meilisearch Configuration
MEILISEARCH_HOST=http://127.0.0.1:7700
MEILISEARCH_API_KEY=your_meilisearch_api_key

# Twilio SMS Configuration
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
