{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "sourceMap": false
  },
  "include": [
    "src/config/**/*.ts",
    "src/db/**/*.ts",
    "src/errors/**/*.ts",
    "src/events/**/*.ts",
    "src/middleware/**/*.ts",
    "src/services/**/*.ts",
    "src/strategies/**/*.ts",
    "src/types/**/*.ts",
    "src/utils/**/*.ts",
    "src/scripts/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
