# Production Environment Variables

# Database Configuration (Production Supabase / Cloud PostgreSQL)
DATABASE_URL=postgresql://user:password@host:port/database
# Set DATABASE_SSL=true if your DB requires SSL but is NOT Supabase (e.g. Neon, Railway, PlanetScale-PG)
# Supabase is auto-detected. Leave unset for local/Docker postgres.
DATABASE_SSL=false

# Server Configuration
PORT=4000
NODE_ENV=production

# JWT Authentication (CHANGE THIS IN PRODUCTION!)
JWT_SECRET=CHANGE_THIS_TO_A_STRONG_RANDOM_SECRET_KEY_IN_PRODUCTION_MIN_32_CHARS
JWT_EXPIRES_IN=7d

# CORS Configuration (Add your production domains)
ALLOWED_ORIGINS=https://odhvica.com,https://www.odhvica.com,https://admin.odhvica.com

# API Rate Limiting
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=900000

# Client Configuration
STOREFRONT_URL=https://odhvica.com
ADMIN_URL=https://admin.odhvica.com
STOREFRONT_REVALIDATE_SECRET=CHANGE_THIS_SHARED_REVALIDATION_SECRET
# Legacy fallback consumed by older flows. Keep aligned with STOREFRONT_URL if present.
FRONTEND_URL=https://odhvica.com

# Cloudinary (Image Upload)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Email Configuration (Resend SMTP relay — https://resend.com)
# SMTP_PASS = your Resend API key (starts with re_)
SMTP_HOST=smtp.resend.com
SMTP_PORT=465
SMTP_USER=resend
SMTP_PASS=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM="Odhvica Support" <support@odhvica.com>
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Payment Gateway (Optional - Stripe)
STRIPE_SECRET_KEY=sk_live_your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=pk_live_your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# Razorpay (India / INR payments)
# Get keys: razorpay.com → Dashboard → Settings → API Keys
RAZORPAY_KEY_ID=rzp_live_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# PayPal (International payments)
# Get keys: developer.paypal.com → My Apps → Create App
PAYPAL_SANDBOX=false
PAYPAL_CLIENT_ID=your_paypal_live_client_id
PAYPAL_CLIENT_SECRET=your_paypal_live_client_secret
PAYPAL_WEBHOOK_ID=your_paypal_live_webhook_id

# Social Login
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Analytics (Optional)
GOOGLE_ANALYTICS_ID=G-XXXXXXXXXX
