#!/usr/bin/env sh

set -eu

while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ] && [ "${ODHVICA_ALLOW_DIRECT_MAIN_PUSH:-0}" != "1" ]; then
    echo "Direct pushes to main are blocked by the Odhvica repository guard."
    echo "Push a feature branch and merge it through a pull request."
    echo "Emergency override: ODHVICA_ALLOW_DIRECT_MAIN_PUSH=1 git push ..."
    exit 1
  fi
done

exit 0
